#!/usr/bin/env bash

set -Eeuo pipefail

pkill -x waybar 2>/dev/null || true
pkill -x swaybg 2>/dev/null || true

# Hyprland can keep HDMI visible internally while failing to advertise it as a
# wl_output to layer-shell clients after switching from mirror to extended mode.
# A short disable/enable cycle forces the Wayland output global to be republished.
hyprctl keyword monitor HDMI-A-1,disable
sleep 0.8
hyprctl keyword monitor HDMI-A-1,1920x1080@60,1280x0,1.5
sleep 0.8

wallpaper="$HOME/Pictures/background.jpg"
# Hyprland >= 0.55 parses `hyprctl dispatch` as Lua; use the Lua API form.
hyprctl dispatch "hl.dsp.exec_cmd(\"swaybg -o eDP-1 -i \\\"$wallpaper\\\" -o HDMI-A-1 -i \\\"$wallpaper\\\"\")"
hyprctl dispatch "hl.dsp.exec_cmd(\"waybar\")"
