#!/usr/bin/env bash

set -euo pipefail

readonly stock_launcher=/usr/bin/hyprlauncher
readonly close_helper="$HOME/.local/libexec/hyprlauncher-ipc"
readonly runtime_dir="${XDG_RUNTIME_DIR:-/tmp}"
readonly socket="$runtime_dir/.hyprlauncher.sock"
readonly lock_file="$runtime_dir/hyprlauncher-toggle.lock"
readonly close_request="$runtime_dir/hyprlauncher-close-requested"
readonly controller_cache="$runtime_dir/hyprlauncher-close-controller"

# Serialize transitions. A repeated press during a transition becomes a close
# request instead of being discarded or queued as another ambiguous toggle.
exec 9>"$lock_file"
coalesced_close=false
if ! flock -n 9; then
    : >"$close_request"
    flock 9
    coalesced_close=true
fi
[[ "$coalesced_close" == false ]] && rm -f -- "$close_request"

layer_open() {
    hyprctl layers -j 2>/dev/null |
        jq -e '.. | objects | select(.namespace? == "hyprlauncher")' \
            >/dev/null
}

wait_for_layer() {
    local wanted="$1"
    local _

    for _ in {1..100}; do
        if [[ "$wanted" == open ]]; then
            layer_open && return 0
        else
            layer_open || return 0
        fi
        sleep 0.005
    done
    return 1
}

start_daemon() {
    if pgrep -x hyprlauncher >/dev/null && [[ -S "$socket" ]]; then
        return 0
    fi

    rm -f -- "$socket"
    # Hyprland >= 0.55 parses `hyprctl dispatch` as Lua; the old bare `exec`
    # syntax no longer works ("attempt to call a nil value (global 'exec')").
    hyprctl dispatch "hl.dsp.exec_cmd(\"$stock_launcher --daemon\")" >/dev/null
    for _ in {1..200}; do
        if pgrep -x hyprlauncher >/dev/null && [[ -S "$socket" ]]; then
            return 0
        fi
        sleep 0.005
    done
    return 1
}

explicit_close() {
    local controller="" cached=""

    # Probe upstream once per session, not on every close. Package upgrades
    # remain untouched; removing this runtime cache rechecks immediately.
    if [[ -r "$controller_cache" ]]; then
        IFS= read -r cached <"$controller_cache" || true
    fi
    if [[ "$cached" == "$stock_launcher" || "$cached" == "$close_helper" ]] &&
        [[ -x "$cached" ]]; then
        controller="$cached"
    elif "$stock_launcher" --help 2>&1 | grep -q -- '--close'; then
        controller="$stock_launcher"
        printf '%s\n' "$controller" >"$controller_cache"
    elif [[ -x "$close_helper" ]]; then
        controller="$close_helper"
        printf '%s\n' "$controller" >"$controller_cache"
    fi

    if [[ -n "$controller" ]]; then
        "$controller" --close >/dev/null 2>&1 || true
        wait_for_layer closed && return 0
    fi

    return 1
}

# A press that arrived during another transition may only close; it must never
# reopen after waiting for the lock. This also clears late request markers.
if [[ "$coalesced_close" == true ]]; then
    if layer_open && ! explicit_close; then
        pkill -TERM -x hyprlauncher 2>/dev/null || true
        wait_for_layer closed || pkill -KILL -x hyprlauncher 2>/dev/null || true
        start_daemon || true
    fi
    rm -f -- "$close_request"
    exit 0
fi

if layer_open; then
    if ! explicit_close; then
        # Protocol/version mismatch fallback: remove the wedged daemon and
        # immediately prewarm a clean official one for the next invocation.
        pkill -TERM -x hyprlauncher 2>/dev/null || true
        wait_for_layer closed || pkill -KILL -x hyprlauncher 2>/dev/null || true
        start_daemon || true
    fi
    rm -f -- "$close_request"
    exit 0
fi

start_daemon || exit 1

# Opening is already an explicit/idempotent operation in the official CLI.
"$stock_launcher" >/dev/null 2>&1 || true
if ! wait_for_layer open; then
    "$stock_launcher" >/dev/null 2>&1 || true
    wait_for_layer open || exit 1
fi

# If Super+D was pressed again before opening completed, honor that press as a
# close. Multiple repeats coalesce into the same deterministic close request.
if [[ -e "$close_request" ]]; then
    rm -f -- "$close_request"
    explicit_close || {
        pkill -TERM -x hyprlauncher 2>/dev/null || true
        wait_for_layer closed || pkill -KILL -x hyprlauncher 2>/dev/null || true
        start_daemon || true
    }
fi
