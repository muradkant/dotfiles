#!/usr/bin/env bash

set -euo pipefail

readonly bus_name=org.flameshot.Flameshot
readonly object_path=/
readonly interface=org.flameshot.Flameshot

flameshot_ready() {
    gdbus introspect --session --dest "$bus_name" --object-path "$object_path" \
        >/dev/null 2>&1
}

if ! flameshot_ready; then
    # Fractional scale 1.5 needs its reciprocal for this Qt/Wayland build.
    env QT_SCALE_FACTOR=0.6666667 QT_QPA_PLATFORM=wayland flameshot >/dev/null 2>&1 &
    for _ in {1..100}; do
        flameshot_ready && break
        sleep 0.02
    done
fi

flameshot_ready || {
    notify-send --app-name=Flameshot 'Screenshot failed' 'Flameshot did not start.'
    exit 1
}

# Reuse the warm daemon rather than killing it and cold-starting Qt per capture.
gdbus call --session --dest "$bus_name" --object-path "$object_path" \
    --method "$interface.captureScreen" >/dev/null
