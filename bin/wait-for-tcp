#!/usr/bin/env bash

set -Eeuo pipefail

host="${1:?usage: wait-for-tcp HOST PORT [TIMEOUT_SECONDS]}"
port="${2:?usage: wait-for-tcp HOST PORT [TIMEOUT_SECONDS]}"
timeout="${3:-30}"
soft="${4:-}"
deadline=$((SECONDS + timeout))

while ((SECONDS < deadline)); do
    if (exec 3<>"/dev/tcp/$host/$port") 2>/dev/null; then
        exec 3>&-
        exec 3<&-
        exit 0
    fi
    sleep 0.1
done

printf 'wait-for-tcp: %s:%s was not ready after %ss\n' \
    "$host" "$port" "$timeout" >&2
[[ "$soft" == --soft ]] && exit 0
exit 1
