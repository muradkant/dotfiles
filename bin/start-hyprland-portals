#!/usr/bin/env bash
# Bring up the XDG Desktop Portal stack for Hyprland so portal-based tools
# (flameshot capture, screen sharing, etc.) work.
#
# Why this exists: xdg-desktop-portal-hyprland ships as a `static` unit with no
# [Install] WantedBy= and no D-Bus activation, so it is not reliably started by
# the session. Worse, it carries `ConditionEnvironment=WAYLAND_DISPLAY`, so if
# anything tries to pull it in before the Wayland environment is imported into
# the systemd user manager, the condition fails and systemd PERMANENTLY skips
# the unit for the whole session (it never retries a failed condition).
# Starting it here from an exec-once guarantees WAYLAND_DISPLAY is already set,
# because Hyprland only runs exec-once after the compositor and its socket are up.
#
# This script is idempotent and safe to run repeatedly.
set -euo pipefail

# Start the Hyprland portal backend if it isn't running.
if ! systemctl --user is-active --quiet xdg-desktop-portal-hyprland.service; then
    systemctl --user start xdg-desktop-portal-hyprland.service || true
fi

# Give the backend a moment to claim its D-Bus name, then nudge the router so it
# connects to the now-available Hyprland implementation. A plain restart of the
# router after the backend is up is what makes the Screenshot interface actually
# usable by flameshot. No-op if the router already has it wired.
for _ in $(seq 1 10); do
    if systemctl --user is-active --quiet xdg-desktop-portal-hyprland.service; then
        break
    fi
    sleep 0.5
done
systemctl --user restart xdg-desktop-portal.service 2>/dev/null || true
