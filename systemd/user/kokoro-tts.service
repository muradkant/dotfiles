[Unit]
Description=Kokoro TTS API
After=network.target

[Service]
Type=simple
ExecStart=%h/.local/share/dotfiles/services/kokoro/venv/bin/python %h/.local/libexec/kokoro-tts-server.py
Environment=KOKORO_MODEL_DIR=%h/.local/share/dotfiles/services/kokoro/model
Environment=PYTHONUNBUFFERED=1
Restart=on-failure
RestartSec=5
UMask=0077

[Install]
WantedBy=default.target
