use_default_settings: true

server:
  secret_key: "@SECRET_KEY@"
  bind_address: "0.0.0.0"
  port: 8080

search:
  safe_search: 0
  autocomplete: ""
  default_lang: "auto"
  formats:
    - html
    - json
  default_page_size: 50

outgoing:
  request_timeout: 15.0
  max_request_timeout: 30.0
  pool_connections: 100
  pool_maxsize: 20

engines:
  - name: google
    disabled: false
  - name: duckduckgo
    disabled: false
  - name: bing
    disabled: false
  - name: brave
    disabled: false
  - name: yahoo
    disabled: false
  - name: startpage
    disabled: false
  - name: wikipedia
    disabled: false
  - name: wikidata
    disabled: false
  - name: currency
    disabled: false
  - name: github
    disabled: false
  - name: stackoverflow
    disabled: false
  - name: arch linux wiki
    disabled: false
  - name: pypi
    disabled: false
  - name: npm
    disabled: false
  - name: docker hub
    disabled: false
  - name: crates.io
    disabled: false
  - name: google scholar
    disabled: false
  - name: arxiv
    disabled: false
  - name: semantic scholar
    disabled: false
  - name: google news
    disabled: false
  - name: bing news
    disabled: false
  - name: youtube
    disabled: false
  - name: reddit
    disabled: false
  - name: openstreetmap
    disabled: false
