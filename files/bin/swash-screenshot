#!/usr/bin/env bash

# Present Swash as a true fullscreen screenshot editor so it is composited
# above Noctalia's layer-shell bar. If that displaces a fullscreen game on the
# current workspace, restore the game's exact internal/client state afterward.

previous_fullscreen_address=""
previous_fullscreen_internal=0
previous_fullscreen_client=0

restore_previous_fullscreen() {
    local address="$previous_fullscreen_address"

    previous_fullscreen_address=""
    if test -z "$address"; then
        return
    fi

    if hyprctl clients -j 2>/dev/null \
        | jq -e --arg address "$address" '.[] | select(.address == $address)' >/dev/null; then
        hyprctl dispatch \
            "hl.dsp.window.fullscreen_state({ internal = $previous_fullscreen_internal, client = $previous_fullscreen_client, action = 'set', window = 'address:$address' })" \
            >/dev/null 2>&1 || true
    fi
}

trap restore_previous_fullscreen EXIT
trap 'exit 130' INT
trap 'exit 143' HUP TERM

if command -v hyprctl >/dev/null && command -v jq >/dev/null; then
    active_workspace=$(hyprctl activeworkspace -j 2>/dev/null | jq -r '.id // empty')

    if test -n "$active_workspace"; then
        IFS=$'\t' read -r previous_fullscreen_address \
            previous_fullscreen_internal previous_fullscreen_client < <(
                hyprctl clients -j 2>/dev/null \
                    | jq -r --argjson workspace "$active_workspace" '
                        .[]
                        | select(
                            .workspace.id == $workspace
                            and .fullscreen > 0
                            and .class != "dev.lemmy.swash"
                        )
                        | [.address, .fullscreen, .fullscreenClient]
                        | @tsv
                    ' \
                    | head -n 1
            )
    fi
fi

swash "$@"
